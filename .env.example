# Copie este arquivo para ".env" (uso local) ou cadastre estas variaveis
# direto no painel do servico de hospedagem (ex: Render > Environment).

# Token fixo que voce escolhe (qualquer palavra/senha) - usado so na etapa
# de verificacao do webhook no Meta for Developers. Precisa ser IGUAL nos dois lugares.
VERIFY_TOKEN=mercoplasa_verify_token

# Token de acesso gerado em Meta for Developers > Mercoplasa Atendimento >
# Conectar no WhatsApp > Configuracao da API > Etapa 1 > "Gerar token".
# O token de teste expira em 24h - antes de ir para producao, gere um
# token permanente (System User) - ver README.
WHATSAPP_TOKEN=

# Phone Number ID (nao e o numero de telefone em si, e o ID interno).
# Numero de teste atual: 1269995032853150
PHONE_NUMBER_ID=1269995032853150

# Versao da Graph API usada nas chamadas.
GRAPH_VERSION=v21.0

# Opcional: numero do atendente unico (com codigo do pais, so digitos,
# ex: 5548999998888) para receber um aviso a cada novo contato triado.
ATENDENTE_WHATSAPP_NUMBER=
